[Unit]
Description=UPC campus network auto login
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/upc-autologin --config /etc/upc-autologin/config.json
Restart=always
RestartSec=10
User=upc-autologin
Group=upc-autologin
RuntimeDirectory=upc-autologin
RuntimeDirectoryMode=0750
UMask=0077
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
